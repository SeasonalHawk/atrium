# PRD v5 Section 14, Deployment and Environment. Copy to .env.local (web,
# console) and never commit real values — .env* is gitignored.

# Supabase (source of truth for leads, targets, runs, artifacts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (booking confirmation + operator alert)
RESEND_API_KEY=
SENDER_EMAIL=hello@altolumo.example
OPERATOR_EMAIL=operator@altolumo.example

# Cal.com (consultation booking)
CALCOM_EVENT_SLUG=
CALCOM_API_KEY=

# Local launcher (console -> launcher -> Claude Code crew)
LAUNCHER_URL=http://localhost:4173
LAUNCHER_PORT=4173
