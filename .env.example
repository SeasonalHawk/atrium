# PRD v5 Section 14, Deployment and Environment. Copy to .env.local (web,
# console) and never commit real values — .env* is gitignored.

# Supabase (source of truth for leads, targets, runs, artifacts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (booking confirmation + operator alert)
RESEND_API_KEY=
SENDER_EMAIL=hello@altolumo.example
OPERATOR_EMAIL=operator@altolumo.example

# Cal.com (consultation booking)
CALCOM_EVENT_SLUG=
CALCOM_API_KEY=

# Local launcher (console -> launcher -> Claude Code crew)
LAUNCHER_URL=http://localhost:4173
LAUNCHER_PORT=4173

# Pexels (stock photography — crew persona avatars, marketing imagery)
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Lead Engine (engine/, PRD v8 Section 9) — sourcing, enrichment, verification
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=

# Lead Engine signals (engine/src/signals/, Sprint 6) — Meta Ad Library
# reuses SERPER_API_KEY above for hiring and Google Ads Transparency signals
META_AD_LIBRARY_ACCESS_TOKEN=

# Hot lead notification (engine/src/notify/hot_lead.py, Sprint 8) — a Slack
# (or Slack-compatible) incoming webhook URL. HOT_LEAD_FIT_THRESHOLD is
# optional, defaults to 90 if unset.
HOT_LEAD_WEBHOOK_URL=
HOT_LEAD_FIT_THRESHOLD=
